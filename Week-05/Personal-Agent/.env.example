# ============================================================================
# Personal AI Agent - Environment Template
# ============================================================================
# Copy this file to '.env' and fill in your own values.
#
#     cp .env.example .env
#
# NEVER commit the real '.env' file to version control.
# ============================================================================

# Your Featherless AI API key (required).
# Get one at: https://featherless.ai
FEATHERLESS_API_KEY=YOUR_FEATHERLESS_API_KEY

# OpenAI-compatible base URL for Featherless (optional, has a default).
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Model served by Featherless (optional, has a default).
MODEL_NAME=deepseek-ai/DeepSeek-V4-Pro
